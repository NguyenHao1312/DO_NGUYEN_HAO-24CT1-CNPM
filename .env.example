# ============================================================
# CẤU HÌNH HỆ THỐNG — Copy file này thành .env và chỉnh sửa nếu cần
# ============================================================
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=your-secret-key-here
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,.ngrok-free.app,.ngrok.io
ADMIN_LOCAL_ONLY=True

# ============================================================
# CẤU HÌNH DATABASE (Microsoft SQL Server)
# ============================================================
DB_NAME=unims_db
DB_HOST=.\SQLEXPRESS
DB_USER=
DB_PASSWORD=
DB_PORT=
DB_DRIVER=ODBC Driver 17 for SQL Server

# ============================================================
# TÙY CHỌN BỔ SUNG
# ============================================================
GEMINI_API_KEY=
